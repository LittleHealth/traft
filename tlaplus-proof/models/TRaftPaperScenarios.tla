------------------------- MODULE TRaftPaperScenarios -------------------------
EXTENDS TRaftPaper
CONSTANTS A, B, C, V1, V2, Scenario
VARIABLE pc
scenarioVars == <<vars, pc>>
VR(c, t) == CHOOSE m \in voteRequests : m.candidate = c /\ m.epoch = t
VM(r, c, t) == CHOOSE m \in voteMessages : m.sender = r /\ m.receiver = c /\ m.epoch = t
RR(c, t) == [owner |-> c, epoch |-> t]
RM(r, c, t) == CHOOSE m \in reportMessages : m.sender = r /\ m.receiver = c /\ m.epoch = t
P(t) == CHOOSE p \in proposals : p.epoch = t
E(t, i) == (CHOOSE ctx \in entryContexts : ctx.entry.term = t /\ ctx.entry.index = i).entry
M(t, i, n) == CHOOSE o \in offers : o.entry = E(t, i) /\ o.committed = n
PA(r, p) == Ack(r, p.owner, p.epoch, p.first, Result(p))
DA(r, c, t, i) == Ack(r, c, t, E(t, i), {E(t, i)})
CN(c, t, e) == [owner |-> c, epoch |-> t, entry |-> e]
BuildLatest(c) == IF ReportedProposals(c) = {} THEN BuildRecovery(c, NoProposal)
                 ELSE \E p \in Latest(ReportedProposals(c)) : BuildRecovery(c, p)
CommitMissing(c, e) == IF e \in knownCommitted[c] THEN UNCHANGED protocolVars
                       ELSE CommitEntry(c, e)
Check(condition) == condition /\ UNCHANGED protocolVars

recoveryStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> SendEntry(A, E(1, 2))
      [] pc = 27 -> CreateEntry(A, V2)
      [] pc = 28 -> SendEntry(A, E(1, 3))
      [] pc = 29 -> ReceiveEntry(B, M(1, 3, 0))
      [] pc = 30 -> AckEntry(A, M(1, 3, 0))
      [] pc = 31 -> AckEntry(B, M(1, 3, 0))
      [] pc = 32 -> DeliverAck(A, DA(A, A, 1, 3))
      [] pc = 33 -> DeliverAck(A, DA(B, A, 1, 3))
      [] pc = 34 -> CommitEntry(A, E(1, 3))
      [] pc = 35 -> ApplyEntry(A, E(1, 3))
      [] pc = 36 -> ReceiveEntry(C, M(1, 2, 0))
      [] pc = 37 -> AckEntry(A, M(1, 2, 0))
      [] pc = 38 -> AckEntry(C, M(1, 2, 0))
      [] pc = 39 -> DeliverAck(A, DA(A, A, 1, 2))
      [] pc = 40 -> DeliverAck(A, DA(C, A, 1, 2))
      [] pc = 41 -> CommitEntry(A, E(1, 2))
      [] pc = 42 -> ApplyEntry(A, E(1, 2))
      [] pc = 43 -> Check(/\ E(1, 2) \in EvidenceEntries /\ E(1, 3) \in EvidenceEntries /\ E(1, 2) \notin stored[B] /\ E(1, 3) \notin stored[C])
      [] pc = 44 -> Crash(A)
      [] pc = 45 -> StartElection(B)
      [] pc = 46 -> AdoptTerm(C, 2)
      [] pc = 47 -> GrantVote(C, VR(B, 2))
      [] pc = 48 -> DeliverVote(B, VM(C, B, 2))
      [] pc = 49 -> WinElection(B)
      [] pc = 50 -> MakeReport(B, RR(B, 2))
      [] pc = 51 -> DeliverReport(B, RM(B, B, 2))
      [] pc = 52 -> MakeReport(C, RR(B, 2))
      [] pc = 53 -> DeliverReport(B, RM(C, B, 2))
      [] pc = 54 -> BuildLatest(B)
      [] pc = 55 -> CopyProposalEntry(B, C, P(2), E(1, 2))
      [] pc = 56 -> RetainProposal(B, P(2))
      [] pc = 57 -> AckProposal(B, P(2))
      [] pc = 58 -> CopyProposalEntry(C, B, P(2), E(1, 3))
      [] pc = 59 -> CopyProposalEntry(C, B, P(2), P(2).first)
      [] pc = 60 -> RetainProposal(C, P(2))
      [] pc = 61 -> AckProposal(C, P(2))
      [] pc = 62 -> DeliverAck(B, PA(B, P(2)))
      [] pc = 63 -> DeliverAck(B, PA(C, P(2)))
      [] pc = 64 -> ConfirmProposal(B)
      [] pc = 65 -> CommitMissing(B, P(1).first)
      [] pc = 66 -> CommitMissing(B, E(1, 2))
      [] pc = 67 -> CommitMissing(B, E(1, 3))
      [] pc = 68 -> CommitEntry(B, P(2).first)
      [] pc = 69 -> Activate(B)
      [] pc = 70 -> LearnConfirmation(C, P(2))
      [] pc = 71 -> AdvertiseCommit(B, E(1, 2))
      [] pc = 72 -> LearnCommit(C, CN(B, 2, E(1, 2)))
      [] pc = 73 -> AdvertiseCommit(B, E(1, 3))
      [] pc = 74 -> LearnCommit(C, CN(B, 2, E(1, 3)))
      [] pc = 75 -> ApplyEntry(C, E(1, 2))
      [] pc = 76 -> ApplyEntry(C, E(1, 3))

interruptedStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> SendEntry(A, E(1, 2))
      [] pc = 27 -> CreateEntry(A, V2)
      [] pc = 28 -> SendEntry(A, E(1, 3))
      [] pc = 29 -> ReceiveEntry(B, M(1, 3, 0))
      [] pc = 30 -> AckEntry(A, M(1, 3, 0))
      [] pc = 31 -> AckEntry(B, M(1, 3, 0))
      [] pc = 32 -> DeliverAck(A, DA(A, A, 1, 3))
      [] pc = 33 -> DeliverAck(A, DA(B, A, 1, 3))
      [] pc = 34 -> CommitEntry(A, E(1, 3))
      [] pc = 35 -> ApplyEntry(A, E(1, 3))
      [] pc = 36 -> ReceiveEntry(C, M(1, 2, 0))
      [] pc = 37 -> AckEntry(A, M(1, 2, 0))
      [] pc = 38 -> AckEntry(C, M(1, 2, 0))
      [] pc = 39 -> DeliverAck(A, DA(A, A, 1, 2))
      [] pc = 40 -> DeliverAck(A, DA(C, A, 1, 2))
      [] pc = 41 -> CommitEntry(A, E(1, 2))
      [] pc = 42 -> ApplyEntry(A, E(1, 2))
      [] pc = 43 -> Check(/\ E(1, 2) \in EvidenceEntries /\ E(1, 3) \in EvidenceEntries /\ E(1, 2) \notin stored[B] /\ E(1, 3) \notin stored[C])
      [] pc = 44 -> Crash(A)
      [] pc = 45 -> StartElection(B)
      [] pc = 46 -> AdoptTerm(C, 2)
      [] pc = 47 -> GrantVote(C, VR(B, 2))
      [] pc = 48 -> DeliverVote(B, VM(C, B, 2))
      [] pc = 49 -> WinElection(B)
      [] pc = 50 -> MakeReport(B, RR(B, 2))
      [] pc = 51 -> DeliverReport(B, RM(B, B, 2))
      [] pc = 52 -> MakeReport(C, RR(B, 2))
      [] pc = 53 -> DeliverReport(B, RM(C, B, 2))
      [] pc = 54 -> BuildLatest(B)
      [] pc = 55 -> CopyProposalEntry(B, C, P(2), E(1, 2))
      [] pc = 56 -> RetainProposal(B, P(2))
      [] pc = 57 -> AckProposal(B, P(2))
      [] pc = 58 -> CopyProposalEntry(C, B, P(2), E(1, 3))
      [] pc = 59 -> CopyProposalEntry(C, B, P(2), P(2).first)
      [] pc = 60 -> RetainProposal(C, P(2))
      [] pc = 61 -> AckProposal(C, P(2))
      [] pc = 62 -> Check(/\ P(2) \notin confirmations /\ Quorum({r \in Replicas : PA(r, P(2)) \in ackMessages}))
      [] pc = 63 -> Crash(B)
      [] pc = 64 -> Restart(A)
      [] pc = 65 -> AdoptTerm(A, 2)
      [] pc = 66 -> StartElection(A)
      [] pc = 67 -> AdoptTerm(C, 3)
      [] pc = 68 -> GrantVote(C, VR(A, 3))
      [] pc = 69 -> DeliverVote(A, VM(C, A, 3))
      [] pc = 70 -> WinElection(A)
      [] pc = 71 -> MakeReport(A, RR(A, 3))
      [] pc = 72 -> DeliverReport(A, RM(A, A, 3))
      [] pc = 73 -> MakeReport(C, RR(A, 3))
      [] pc = 74 -> DeliverReport(A, RM(C, A, 3))
      [] pc = 75 -> BuildLatest(A)
      [] pc = 76 -> CopyProposalEntry(A, C, P(3), P(2).first)
      [] pc = 77 -> RetainProposal(A, P(3))
      [] pc = 78 -> AckProposal(A, P(3))
      [] pc = 79 -> CopyProposalEntry(C, A, P(3), P(3).first)
      [] pc = 80 -> RetainProposal(C, P(3))
      [] pc = 81 -> AckProposal(C, P(3))
      [] pc = 82 -> DeliverAck(A, PA(A, P(3)))
      [] pc = 83 -> DeliverAck(A, PA(C, P(3)))
      [] pc = 84 -> ConfirmProposal(A)
      [] pc = 85 -> CommitMissing(A, P(1).first)
      [] pc = 86 -> CommitMissing(A, E(1, 2))
      [] pc = 87 -> CommitMissing(A, E(1, 3))
      [] pc = 88 -> CommitMissing(A, P(2).first)
      [] pc = 89 -> CommitEntry(A, P(3).first)
      [] pc = 90 -> Activate(A)

normal_boundaryStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> SendEntry(A, E(1, 2))
      [] pc = 27 -> CreateEntry(A, V2)
      [] pc = 28 -> SendEntry(A, E(1, 3))
      [] pc = 29 -> ReceiveEntry(B, M(1, 3, 0))
      [] pc = 30 -> AckEntry(A, M(1, 3, 0))
      [] pc = 31 -> AckEntry(B, M(1, 3, 0))
      [] pc = 32 -> DeliverAck(A, DA(A, A, 1, 3))
      [] pc = 33 -> DeliverAck(A, DA(B, A, 1, 3))
      [] pc = 34 -> CommitEntry(A, E(1, 3))
      [] pc = 35 -> ApplyEntry(A, E(1, 3))
      [] pc = 36 -> ReceiveEntry(C, M(1, 2, 0))
      [] pc = 37 -> AckEntry(A, M(1, 2, 0))
      [] pc = 38 -> AckEntry(C, M(1, 2, 0))
      [] pc = 39 -> DeliverAck(A, DA(A, A, 1, 2))
      [] pc = 40 -> DeliverAck(A, DA(C, A, 1, 2))
      [] pc = 41 -> CommitEntry(A, E(1, 2))
      [] pc = 42 -> ApplyEntry(A, E(1, 2))
      [] pc = 43 -> Check(/\ E(1, 2) \in EvidenceEntries /\ E(1, 3) \in EvidenceEntries /\ E(1, 2) \notin stored[B] /\ E(1, 3) \notin stored[C])
      [] pc = 44 -> CreateSuccessor(A, V1, "data")
      [] pc = 45 -> SendEntry(A, E(1, 4))
      [] pc = 46 -> Check(~CanReceive(B, M(1, 4, 3)))
      [] pc = 47 -> ReceiveEntry(B, M(1, 2, 0))
      [] pc = 48 -> ReceiveEntry(B, M(1, 4, 3))
      [] pc = 49 -> Check(/\ E(1, 4) \in formal[B] /\ ~Quorum(MessageAckers(ackMessages, A, 1, E(1, 4))))
      [] pc = 50 -> AckEntry(A, M(1, 4, 3))
      [] pc = 51 -> AckEntry(B, M(1, 4, 3))
      [] pc = 52 -> DeliverAck(A, DA(A, A, 1, 4))
      [] pc = 53 -> DeliverAck(A, DA(B, A, 1, 4))
      [] pc = 54 -> CommitEntry(A, E(1, 4))
      [] pc = 55 -> ApplyEntry(A, P(1).first)
      [] pc = 56 -> ApplyEntry(A, E(1, 4))
      [] pc = 57 -> LearnConfirmation(B, P(1))
      [] pc = 58 -> Check(E(1, 4) \in formal[B])
      [] pc = 59 -> Crash(A)
      [] pc = 60 -> StartElection(B)
      [] pc = 61 -> AdoptTerm(C, 2)
      [] pc = 62 -> GrantVote(C, VR(B, 2))
      [] pc = 63 -> DeliverVote(B, VM(C, B, 2))
      [] pc = 64 -> WinElection(B)
      [] pc = 65 -> MakeReport(B, RR(B, 2))
      [] pc = 66 -> DeliverReport(B, RM(B, B, 2))
      [] pc = 67 -> MakeReport(C, RR(B, 2))
      [] pc = 68 -> DeliverReport(B, RM(C, B, 2))
      [] pc = 69 -> BuildLatest(B)
      [] pc = 70 -> RetainProposal(B, P(2))
      [] pc = 71 -> AckProposal(B, P(2))
      [] pc = 72 -> CopyProposalEntry(C, B, P(2), E(1, 3))
      [] pc = 73 -> CopyProposalEntry(C, B, P(2), E(1, 4))
      [] pc = 74 -> CopyProposalEntry(C, B, P(2), P(2).first)
      [] pc = 75 -> RetainProposal(C, P(2))
      [] pc = 76 -> AckProposal(C, P(2))
      [] pc = 77 -> DeliverAck(B, PA(B, P(2)))
      [] pc = 78 -> DeliverAck(B, PA(C, P(2)))
      [] pc = 79 -> ConfirmProposal(B)
      [] pc = 80 -> CommitMissing(B, P(1).first)
      [] pc = 81 -> CommitMissing(B, E(1, 2))
      [] pc = 82 -> CommitMissing(B, E(1, 3))
      [] pc = 83 -> CommitMissing(B, E(1, 4))
      [] pc = 84 -> CommitEntry(B, P(2).first)
      [] pc = 85 -> Activate(B)

uncommitted_rollbackStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> CreateSuccessor(A, V2, "data")
      [] pc = 27 -> Crash(A)
      [] pc = 28 -> StartElection(B)
      [] pc = 29 -> AdoptTerm(C, 2)
      [] pc = 30 -> GrantVote(C, VR(B, 2))
      [] pc = 31 -> DeliverVote(B, VM(C, B, 2))
      [] pc = 32 -> WinElection(B)
      [] pc = 33 -> MakeReport(B, RR(B, 2))
      [] pc = 34 -> DeliverReport(B, RM(B, B, 2))
      [] pc = 35 -> MakeReport(C, RR(B, 2))
      [] pc = 36 -> DeliverReport(B, RM(C, B, 2))
      [] pc = 37 -> BuildLatest(B)
      [] pc = 38 -> RetainProposal(B, P(2))
      [] pc = 39 -> AckProposal(B, P(2))
      [] pc = 40 -> CopyProposalEntry(C, B, P(2), P(2).first)
      [] pc = 41 -> RetainProposal(C, P(2))
      [] pc = 42 -> AckProposal(C, P(2))
      [] pc = 43 -> DeliverAck(B, PA(B, P(2)))
      [] pc = 44 -> DeliverAck(B, PA(C, P(2)))
      [] pc = 45 -> ConfirmProposal(B)
      [] pc = 46 -> CommitMissing(B, P(1).first)
      [] pc = 47 -> CommitEntry(B, P(2).first)
      [] pc = 48 -> Activate(B)

quorum_guardStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> SendEntry(A, E(1, 2))
      [] pc = 27 -> Check(~ENABLED CommitEntry(A, E(1, 2)))
      [] pc = 28 -> AckEntry(A, M(1, 2, 0))
      [] pc = 29 -> DeliverAck(A, DA(A, A, 1, 2))
      [] pc = 30 -> Check(~ENABLED CommitEntry(A, E(1, 2)))

count_guardStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> SendEntry(A, E(1, 2))
      [] pc = 27 -> ReceiveEntry(B, M(1, 2, 0))
      [] pc = 28 -> CreateSuccessor(A, V2, "data")
      [] pc = 29 -> SendEntry(A, E(1, 3))
      [] pc = 30 -> Check(~CanReceive(B, M(1, 3, 1)))
      [] pc = 31 -> AckEntry(A, M(1, 2, 0))
      [] pc = 32 -> AckEntry(B, M(1, 2, 0))
      [] pc = 33 -> DeliverAck(A, DA(A, A, 1, 2))
      [] pc = 34 -> DeliverAck(A, DA(B, A, 1, 2))
      [] pc = 35 -> CommitEntry(A, E(1, 2))
      [] pc = 36 -> SendEntry(A, E(1, 3))
      [] pc = 37 -> Check(~CanReceive(B, M(1, 3, 1)))
      [] pc = 38 -> ReceiveEntry(B, M(1, 3, 2))

bad_commitStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> SendEntry(A, E(1, 2))
      [] pc = 27 -> CommitEntry(A, E(1, 2))

bad_countStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> SendEntry(A, E(1, 2))
      [] pc = 27 -> ReceiveEntry(B, M(1, 2, 0))
      [] pc = 28 -> CreateSuccessor(A, V2, "data")
      [] pc = 29 -> SendEntry(A, E(1, 3))
      [] pc = 30 -> ReceiveEntry(B, M(1, 3, 1))
      [] pc = 31 -> AckEntry(A, M(1, 3, 1))
      [] pc = 32 -> AckEntry(B, M(1, 3, 1))

early_recoveryStep ==
    CASE pc = 0 -> StartElection(A)
      [] pc = 1 -> AdoptTerm(B, 1)
      [] pc = 2 -> GrantVote(B, VR(A, 1))
      [] pc = 3 -> DeliverVote(A, VM(B, A, 1))
      [] pc = 4 -> WinElection(A)
      [] pc = 5 -> MakeReport(A, RR(A, 1))
      [] pc = 6 -> DeliverReport(A, RM(A, A, 1))
      [] pc = 7 -> MakeReport(B, RR(A, 1))
      [] pc = 8 -> DeliverReport(A, RM(B, A, 1))
      [] pc = 9 -> BuildRecovery(A, NoProposal)
      [] pc = 10 -> RetainProposal(A, P(1))
      [] pc = 11 -> AckProposal(A, P(1))
      [] pc = 12 -> DeliverAck(A, PA(A, P(1)))
      [] pc = 13 -> CopyProposalEntry(B, A, P(1), P(1).first)
      [] pc = 14 -> RetainProposal(B, P(1))
      [] pc = 15 -> AckProposal(B, P(1))
      [] pc = 16 -> DeliverAck(A, PA(B, P(1)))
      [] pc = 17 -> ConfirmProposal(A)
      [] pc = 18 -> CommitEntry(A, P(1).first)
      [] pc = 19 -> Activate(A)
      [] pc = 20 -> LearnConfirmation(B, P(1))
      [] pc = 21 -> AdoptTerm(C, 1)
      [] pc = 22 -> CopyProposalEntry(C, A, P(1), P(1).first)
      [] pc = 23 -> RetainProposal(C, P(1))
      [] pc = 24 -> LearnConfirmation(C, P(1))
      [] pc = 25 -> CreateEntry(A, V1)
      [] pc = 26 -> SendEntry(A, E(1, 2))
      [] pc = 27 -> CreateEntry(A, V2)
      [] pc = 28 -> SendEntry(A, E(1, 3))
      [] pc = 29 -> ReceiveEntry(B, M(1, 3, 0))
      [] pc = 30 -> AckEntry(A, M(1, 3, 0))
      [] pc = 31 -> AckEntry(B, M(1, 3, 0))
      [] pc = 32 -> DeliverAck(A, DA(A, A, 1, 3))
      [] pc = 33 -> DeliverAck(A, DA(B, A, 1, 3))
      [] pc = 34 -> CommitEntry(A, E(1, 3))
      [] pc = 35 -> ApplyEntry(A, E(1, 3))
      [] pc = 36 -> ReceiveEntry(C, M(1, 2, 0))
      [] pc = 37 -> AckEntry(A, M(1, 2, 0))
      [] pc = 38 -> AckEntry(C, M(1, 2, 0))
      [] pc = 39 -> DeliverAck(A, DA(A, A, 1, 2))
      [] pc = 40 -> DeliverAck(A, DA(C, A, 1, 2))
      [] pc = 41 -> CommitEntry(A, E(1, 2))
      [] pc = 42 -> ApplyEntry(A, E(1, 2))
      [] pc = 43 -> Check(/\ E(1, 2) \in EvidenceEntries /\ E(1, 3) \in EvidenceEntries /\ E(1, 2) \notin stored[B] /\ E(1, 3) \notin stored[C])
      [] pc = 44 -> Crash(A)
      [] pc = 45 -> StartElection(B)
      [] pc = 46 -> AdoptTerm(C, 2)
      [] pc = 47 -> GrantVote(C, VR(B, 2))
      [] pc = 48 -> DeliverVote(B, VM(C, B, 2))
      [] pc = 49 -> WinElection(B)
      [] pc = 50 -> MakeReport(B, RR(B, 2))
      [] pc = 51 -> DeliverReport(B, RM(B, B, 2))
      [] pc = 52 -> MakeReport(C, RR(B, 2))
      [] pc = 53 -> DeliverReport(B, RM(C, B, 2))
      [] pc = 54 -> BuildLatest(B)
      [] pc = 55 -> CopyProposalEntry(B, C, P(2), E(1, 2))
      [] pc = 56 -> RetainProposal(B, P(2))
      [] pc = 57 -> AckProposal(B, P(2))
      [] pc = 58 -> DeliverAck(B, PA(B, P(2)))
      [] pc = 59 -> ConfirmProposal(B)

ScenarioLength == CASE Scenario = "recovery" -> 77
                    [] Scenario = "interrupted" -> 91
                    [] Scenario = "normal_boundary" -> 86
                    [] Scenario = "uncommitted_rollback" -> 49
                    [] Scenario = "quorum_guard" -> 31
                    [] Scenario = "count_guard" -> 39
                    [] Scenario = "bad_commit" -> 28
                    [] Scenario = "bad_count" -> 33
                    [] Scenario = "early_recovery" -> 60
ScenarioStep == CASE Scenario = "recovery" -> recoveryStep
                  [] Scenario = "interrupted" -> interruptedStep
                  [] Scenario = "normal_boundary" -> normal_boundaryStep
                  [] Scenario = "uncommitted_rollback" -> uncommitted_rollbackStep
                  [] Scenario = "quorum_guard" -> quorum_guardStep
                  [] Scenario = "count_guard" -> count_guardStep
                  [] Scenario = "bad_commit" -> bad_commitStep
                  [] Scenario = "bad_count" -> bad_countStep
                  [] Scenario = "early_recovery" -> early_recoveryStep

ScenarioInit == Init /\ pc = 0
ScenarioNext ==
    \/ /\ pc < ScenarioLength /\ ScenarioStep /\ Observe /\ pc' = pc + 1
    \/ /\ pc = ScenarioLength /\ UNCHANGED scenarioVars
ScenarioSpec == ScenarioInit /\ [][ScenarioNext]_scenarioVars
ScenarioTypeOK == pc \in 0..ScenarioLength
ScenarioRefinesReference == [][Next]_vars
NoScenarioCompletion == pc < ScenarioLength
\* CHECK_DEADLOCK TRUE detects any disabled scripted step. Terminal stuttering
\* plus these assertions makes a successful run check the intended endpoint.
ScenarioEndpoint == pc = ScenarioLength =>
    CASE Scenario = "recovery" ->
           /\ role[B] = "Leader" /\ term[B] = 2 /\ ~alive[A]
           /\ {E(1, 2), E(1, 3)} \subseteq formal[B] \cap applied[C]
      [] Scenario = "interrupted" ->
           /\ role[A] = "Leader" /\ term[A] = 3
           /\ P(2) \notin confirmations /\ Result(P(2)) \subseteq formal[A]
      [] Scenario = "normal_boundary" ->
           /\ role[B] = "Leader" /\ term[B] = 2
           /\ E(1, 4) \in formal[B] \cap EvidenceEntries
           /\ \A p \in proposals : p.recovering
      [] Scenario = "uncommitted_rollback" ->
           /\ role[B] = "Leader" /\ term[B] = 2
           /\ E(1, 2) \notin formal[B] /\ E(1, 2) \in formal[A]
           /\ Part(formal[A], 0) # Part(formal[B], 0)
      [] Scenario = "quorum_guard" -> E(1, 2) \notin knownCommitted[A]
      [] Scenario = "count_guard" -> E(1, 3) \in formal[B]
      [] OTHER -> TRUE
=============================================================================

      [] pc = 80 -> CommitMissingClient(B, E(1, 2))
      [] pc = 81 -> CommitMissingClient(B, E(1, 3))
      [] pc = 82 -> Core(CommitEntry(B, P(2).first))
      [] pc = 83 -> Core(Activate(B))
      [] pc = 84 -> Core(LearnConfirmation(C, P(2)))
      [] pc = 85 -> ApplyMissing(B, E(1, 1))
      [] pc = 86 -> ApplyMissing(B, E(1, 2))
      [] pc = 87 -> ApplyMissing(B, E(1, 3))
      [] pc = 88 -> ApplyClient(B, P(2).first)
      [] pc = 89 -> Admit(B, PutX)
      [] pc = 90 -> Core(SendEntry(B, E(2, 5)))
      [] pc = 91 -> Core(ReceiveEntry(C, M(2, 5)))
      [] pc = 92 -> Core(AckEntry(B, M(2, 5)))
      [] pc = 93 -> Core(AckEntry(C, M(2, 5)))

ScenarioLength == CASE Scenario = "point_operations" -> 78
                    [] Scenario = "concurrent_overwrite" -> 66
                    [] Scenario = "dedup_restart" -> 112
                    [] Scenario = "recovery_retry" -> 113
                    [] Scenario = "stale_read" -> 45
                    [] Scenario = "early_reply" -> 74
ScenarioStep == CASE Scenario = "point_operations" -> point_operationsStep
                  [] Scenario = "concurrent_overwrite" -> concurrent_overwriteStep
                  [] Scenario = "dedup_restart" -> dedup_restartStep
                  [] Scenario = "recovery_retry" -> recovery_retryStep
                  [] Scenario = "stale_read" -> stale_readStep
                  [] Scenario = "early_reply" -> early_replyStep

ScenarioInit == ClientInit /\ pc = 0
ScenarioNext ==
    \/ /\ pc < ScenarioLength /\ ScenarioStep /\ Observe /\ ObserveLinearization /\ pc' = pc + 1
    \/ /\ pc = ScenarioLength /\ UNCHANGED scenarioClientVars
ScenarioSpec == ScenarioInit /\ [][ScenarioNext]_scenarioClientVars
ScenarioRefinesClient == [][ClientNext]_clientVars
ScenarioEndpoint == pc = ScenarioLength =>
    CASE Scenario = "point_operations" ->
             \E m \in returned : m.id = ReadY2.id /\ m.value = Missing
      [] Scenario = "concurrent_overwrite" ->
             \E m \in returned : m.id = ReadX2.id /\ m.value = V2
      [] Scenario = "dedup_restart" ->
             \E m \in returned : m.id = ReadY2.id /\ m.value = V2
      [] Scenario = "recovery_retry" ->
             \E m \in returned : m.id = ReadY2.id /\ m.value = V1
      [] OTHER -> TRUE

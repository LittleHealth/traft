      [] pc = 42 -> Invoke(PutY)
      [] pc = 43 -> Admit(A, PutY)
      [] pc = 44 -> Core(SendEntry(A, E(1, 3)))
      [] pc = 45 -> Core(ReceiveEntry(B, M(1, 3)))
      [] pc = 46 -> Core(AckEntry(A, M(1, 3)))
      [] pc = 47 -> Core(AckEntry(B, M(1, 3)))
      [] pc = 48 -> Core(DeliverAck(A, DA(A, A, 1, 3)))
      [] pc = 49 -> Core(DeliverAck(A, DA(B, A, 1, 3)))
      [] pc = 50 -> Core(CommitEntry(A, E(1, 3)))
      [] pc = 51 -> ApplyClient(A, E(1, 3))
      [] pc = 52 -> SendReply(A, PutY)
      [] pc = 53 -> ReceiveReply(RP(A, PutY))
      [] pc = 54 -> Core(Crash(A))
      [] pc = 55 -> Core(Restart(A))
      [] pc = 56 -> Core(StartElection(A))
      [] pc = 57 -> Core(AdoptTerm(B, 2))
      [] pc = 58 -> Core(GrantVote(B, VR(A, 2)))
      [] pc = 59 -> Core(DeliverVote(A, VM(B, A, 2)))
      [] pc = 60 -> Core(WinElection(A))
      [] pc = 61 -> Core(MakeReport(A, RR(A, 2)))
      [] pc = 62 -> Core(DeliverReport(A, RM(A, A, 2)))
      [] pc = 63 -> Core(MakeReport(B, RR(A, 2)))
      [] pc = 64 -> Core(DeliverReport(A, RM(B, A, 2)))
      [] pc = 65 -> BuildLatestClient(A)
      [] pc = 66 -> CopyMissing(A, B, P(2), E(1, 1))
      [] pc = 67 -> CopyMissing(A, B, P(2), E(1, 2))
      [] pc = 68 -> CopyMissing(A, B, P(2), E(1, 3))
      [] pc = 69 -> CopyMissing(A, A, P(2), P(2).first)
      [] pc = 70 -> Core(RetainProposal(A, P(2)))

------------------------- MODULE TRaftClientScenarios -----------------------
EXTENDS TRaftClients
CONSTANTS A, B, C, X, Y, S, V1, V2, Scenario
VARIABLE pc
scenarioClientVars == <<clientVars, pc>>
Q(c, n, op, timestamp, v) == [id |-> <<c, n>>, op |-> op, key |-> <<S, timestamp>>, value |-> v]
PutX == Q(X, 1, "Put", 1, V1)
PutY == Q(Y, 1, "Put", 1, V2)
PutYOther == Q(Y, 1, "Put", 2, V2)
ReadY == Q(Y, 1, "Get", 1, Missing)
ReadY2 == Q(Y, 2, "Get", 1, Missing)
ReadX2 == Q(X, 2, "Get", 1, Missing)
DeleteX == Q(X, 2, "Delete", 1, Missing)
Core(action) == action /\ Background
Check(condition) == condition /\ UNCHANGED <<protocolVars, localClientVars>>
VR(c,t) == CHOOSE m \in voteRequests : m.candidate = c /\ m.epoch = t
VM(r,c,t) == CHOOSE m \in voteMessages : m.sender = r /\ m.receiver = c /\ m.epoch = t
RR(c,t) == [owner |-> c, epoch |-> t]
RM(r,c,t) == CHOOSE m \in reportMessages : m.sender = r /\ m.receiver = c /\ m.epoch = t
P(t) == CHOOSE p \in proposals : p.epoch = t
E(t,i) == (CHOOSE ctx \in entryContexts : ctx.entry.term = t /\ ctx.entry.index = i).entry
M(t,i) == CHOOSE o \in offers : o.entry = E(t,i) /\ o.committed = o.entry.prevSize
PA(r,p) == Ack(r, p.owner, p.epoch, p.first, Result(p))
DA(r,c,t,i) == Ack(r,c,t,E(t,i),{E(t,i)})
CN(c,t,e) == [owner |-> c, epoch |-> t, entry |-> e]
RP(r,q) == [sender |-> r, id |-> q.id, value |-> cache[r][q.id].value]
BuildLatestClient(c) == IF ReportedProposals(c) = {} THEN Core(BuildRecovery(c, NoProposal))
                        ELSE \E p \in Latest(ReportedProposals(c)) : Core(BuildRecovery(c,p))
CopyMissing(r,s,p,e) == IF e \in stored[r] THEN Check(TRUE) ELSE Core(CopyProposalEntry(r,s,p,e))
CommitMissingClient(r,e) == IF e \in knownCommitted[r] THEN Check(TRUE) ELSE Core(CommitEntry(r,e))
ApplyMissing(r,e) == IF e \in applied[r] THEN Check(TRUE) ELSE ApplyClient(r,e)

point_operationsStep ==
    CASE pc = 0 -> Core(StartElection(A))
      [] pc = 1 -> Core(AdoptTerm(B, 1))
      [] pc = 2 -> Core(GrantVote(B, VR(A, 1)))
      [] pc = 3 -> Core(DeliverVote(A, VM(B, A, 1)))
      [] pc = 4 -> Core(WinElection(A))
      [] pc = 5 -> Core(MakeReport(A, RR(A, 1)))
      [] pc = 6 -> Core(DeliverReport(A, RM(A, A, 1)))
      [] pc = 7 -> Core(MakeReport(B, RR(A, 1)))
      [] pc = 8 -> Core(DeliverReport(A, RM(B, A, 1)))
      [] pc = 9 -> Core(BuildRecovery(A, NoProposal))
      [] pc = 10 -> Core(RetainProposal(A, P(1)))
      [] pc = 11 -> Core(AckProposal(A, P(1)))
      [] pc = 12 -> Core(DeliverAck(A, PA(A, P(1))))
      [] pc = 13 -> Core(CopyProposalEntry(B, A, P(1), P(1).first))
      [] pc = 14 -> Core(RetainProposal(B, P(1)))
      [] pc = 15 -> Core(AckProposal(B, P(1)))
      [] pc = 16 -> Core(DeliverAck(A, PA(B, P(1))))
      [] pc = 17 -> Core(ConfirmProposal(A))
      [] pc = 18 -> Core(CommitEntry(A, P(1).first))
      [] pc = 19 -> Core(Activate(A))
      [] pc = 20 -> Core(LearnConfirmation(B, P(1)))
      [] pc = 21 -> Core(AdoptTerm(C, 1))
      [] pc = 22 -> Core(CopyProposalEntry(C, A, P(1), P(1).first))
      [] pc = 23 -> Core(RetainProposal(C, P(1)))
      [] pc = 24 -> Core(LearnConfirmation(C, P(1)))
      [] pc = 25 -> Core(LearnCommit(B, CN(A, 1, P(1).first)))
      [] pc = 26 -> Core(LearnCommit(C, CN(A, 1, P(1).first)))
      [] pc = 27 -> ApplyClient(A, P(1).first)
      [] pc = 28 -> ApplyClient(B, P(1).first)
      [] pc = 29 -> ApplyClient(C, P(1).first)
      [] pc = 30 -> Invoke(PutX)
      [] pc = 31 -> Admit(A, PutX)
      [] pc = 32 -> Core(SendEntry(A, E(1, 2)))
      [] pc = 33 -> Core(ReceiveEntry(B, M(1, 2)))
      [] pc = 34 -> Core(AckEntry(A, M(1, 2)))
      [] pc = 35 -> Core(AckEntry(B, M(1, 2)))
      [] pc = 36 -> Core(DeliverAck(A, DA(A, A, 1, 2)))
      [] pc = 37 -> Core(DeliverAck(A, DA(B, A, 1, 2)))
      [] pc = 38 -> Core(CommitEntry(A, E(1, 2)))
      [] pc = 39 -> ApplyClient(A, E(1, 2))
      [] pc = 40 -> SendReply(A, PutX)
      [] pc = 41 -> ReceiveReply(RP(A, PutX))
      [] pc = 42 -> Invoke(ReadY)
      [] pc = 43 -> Admit(A, ReadY)
      [] pc = 44 -> Core(SendEntry(A, E(1, 3)))
      [] pc = 45 -> Core(ReceiveEntry(B, M(1, 3)))
      [] pc = 46 -> Core(AckEntry(A, M(1, 3)))
      [] pc = 47 -> Core(AckEntry(B, M(1, 3)))
      [] pc = 48 -> Core(DeliverAck(A, DA(A, A, 1, 3)))
      [] pc = 49 -> Core(DeliverAck(A, DA(B, A, 1, 3)))
      [] pc = 50 -> Core(CommitEntry(A, E(1, 3)))
      [] pc = 51 -> ApplyClient(A, E(1, 3))
      [] pc = 52 -> SendReply(A, ReadY)
      [] pc = 53 -> ReceiveReply(RP(A, ReadY))
      [] pc = 54 -> Invoke(DeleteX)
      [] pc = 55 -> Admit(A, DeleteX)
      [] pc = 56 -> Core(SendEntry(A, E(1, 4)))
      [] pc = 57 -> Core(ReceiveEntry(B, M(1, 4)))
      [] pc = 58 -> Core(AckEntry(A, M(1, 4)))
      [] pc = 59 -> Core(AckEntry(B, M(1, 4)))
      [] pc = 60 -> Core(DeliverAck(A, DA(A, A, 1, 4)))
      [] pc = 61 -> Core(DeliverAck(A, DA(B, A, 1, 4)))
      [] pc = 62 -> Core(CommitEntry(A, E(1, 4)))
      [] pc = 63 -> ApplyClient(A, E(1, 4))
      [] pc = 64 -> SendReply(A, DeleteX)
      [] pc = 65 -> ReceiveReply(RP(A, DeleteX))
      [] pc = 66 -> Invoke(ReadY2)
      [] pc = 67 -> Admit(A, ReadY2)
      [] pc = 68 -> Core(SendEntry(A, E(1, 5)))
      [] pc = 69 -> Core(ReceiveEntry(B, M(1, 5)))
      [] pc = 70 -> Core(AckEntry(A, M(1, 5)))
      [] pc = 71 -> Core(AckEntry(B, M(1, 5)))
      [] pc = 72 -> Core(DeliverAck(A, DA(A, A, 1, 5)))
      [] pc = 73 -> Core(DeliverAck(A, DA(B, A, 1, 5)))
      [] pc = 74 -> Core(CommitEntry(A, E(1, 5)))
      [] pc = 75 -> ApplyClient(A, E(1, 5))
      [] pc = 76 -> SendReply(A, ReadY2)
      [] pc = 77 -> ReceiveReply(RP(A, ReadY2))


      [] pc = 108 -> Core(CommitEntry(A, E(2, 6)))
      [] pc = 109 -> ApplyClient(A, E(2, 6))
      [] pc = 110 -> SendReply(A, ReadY2)
      [] pc = 111 -> ReceiveReply(RP(A, ReadY2))

recovery_retryStep ==
    CASE pc = 0 -> Core(StartElection(A))
      [] pc = 1 -> Core(AdoptTerm(B, 1))
      [] pc = 2 -> Core(GrantVote(B, VR(A, 1)))
      [] pc = 3 -> Core(DeliverVote(A, VM(B, A, 1)))
      [] pc = 4 -> Core(WinElection(A))
      [] pc = 5 -> Core(MakeReport(A, RR(A, 1)))
      [] pc = 6 -> Core(DeliverReport(A, RM(A, A, 1)))
      [] pc = 7 -> Core(MakeReport(B, RR(A, 1)))
      [] pc = 8 -> Core(DeliverReport(A, RM(B, A, 1)))
      [] pc = 9 -> Core(BuildRecovery(A, NoProposal))
      [] pc = 10 -> Core(RetainProposal(A, P(1)))
      [] pc = 11 -> Core(AckProposal(A, P(1)))
      [] pc = 12 -> Core(DeliverAck(A, PA(A, P(1))))
      [] pc = 13 -> Core(CopyProposalEntry(B, A, P(1), P(1).first))
      [] pc = 14 -> Core(RetainProposal(B, P(1)))
      [] pc = 15 -> Core(AckProposal(B, P(1)))
      [] pc = 16 -> Core(DeliverAck(A, PA(B, P(1))))
      [] pc = 17 -> Core(ConfirmProposal(A))
      [] pc = 18 -> Core(CommitEntry(A, P(1).first))
      [] pc = 19 -> Core(Activate(A))
      [] pc = 20 -> Core(LearnConfirmation(B, P(1)))
      [] pc = 21 -> Core(AdoptTerm(C, 1))
      [] pc = 22 -> Core(CopyProposalEntry(C, A, P(1), P(1).first))
      [] pc = 23 -> Core(RetainProposal(C, P(1)))
      [] pc = 24 -> Core(LearnConfirmation(C, P(1)))
      [] pc = 25 -> Core(LearnCommit(B, CN(A, 1, P(1).first)))
      [] pc = 26 -> Core(LearnCommit(C, CN(A, 1, P(1).first)))
      [] pc = 27 -> ApplyClient(A, P(1).first)
      [] pc = 28 -> ApplyClient(B, P(1).first)
      [] pc = 29 -> ApplyClient(C, P(1).first)
      [] pc = 30 -> Invoke(PutX)
      [] pc = 31 -> Invoke(PutYOther)
      [] pc = 32 -> Admit(A, PutX)
      [] pc = 33 -> Core(SendEntry(A, E(1, 2)))
      [] pc = 34 -> Admit(A, PutYOther)
      [] pc = 35 -> Core(SendEntry(A, E(1, 3)))
      [] pc = 36 -> Core(ReceiveEntry(B, M(1, 3)))
      [] pc = 37 -> Core(AckEntry(A, M(1, 3)))
      [] pc = 38 -> Core(AckEntry(B, M(1, 3)))
      [] pc = 39 -> Core(DeliverAck(A, DA(A, A, 1, 3)))
      [] pc = 40 -> Core(DeliverAck(A, DA(B, A, 1, 3)))
      [] pc = 41 -> Core(CommitEntry(A, E(1, 3)))
      [] pc = 42 -> ApplyClient(A, E(1, 3))
      [] pc = 43 -> SendReply(A, PutYOther)
      [] pc = 44 -> ReceiveReply(RP(A, PutYOther))
      [] pc = 45 -> Core(ReceiveEntry(C, M(1, 2)))
      [] pc = 46 -> Core(AckEntry(A, M(1, 2)))
      [] pc = 47 -> Core(AckEntry(C, M(1, 2)))
      [] pc = 48 -> Core(DeliverAck(A, DA(A, A, 1, 2)))
      [] pc = 49 -> Core(DeliverAck(A, DA(C, A, 1, 2)))
      [] pc = 50 -> Core(CommitEntry(A, E(1, 2)))
      [] pc = 51 -> ApplyClient(A, E(1, 2))
      [] pc = 52 -> SendReply(A, PutX)
      [] pc = 53 -> Core(Crash(A))
      [] pc = 54 -> Core(StartElection(B))
      [] pc = 55 -> Core(AdoptTerm(C, 2))
      [] pc = 56 -> Core(GrantVote(C, VR(B, 2)))
      [] pc = 57 -> Core(DeliverVote(B, VM(C, B, 2)))
      [] pc = 58 -> Core(WinElection(B))
      [] pc = 59 -> Core(MakeReport(B, RR(B, 2)))
      [] pc = 60 -> Core(DeliverReport(B, RM(B, B, 2)))
      [] pc = 61 -> Core(MakeReport(C, RR(B, 2)))
      [] pc = 62 -> Core(DeliverReport(B, RM(C, B, 2)))
      [] pc = 63 -> BuildLatestClient(B)
      [] pc = 64 -> CopyMissing(B, C, P(2), E(1, 1))
      [] pc = 65 -> CopyMissing(B, C, P(2), E(1, 2))
      [] pc = 66 -> CopyMissing(B, C, P(2), E(1, 3))
      [] pc = 67 -> CopyMissing(B, B, P(2), P(2).first)
      [] pc = 68 -> Core(RetainProposal(B, P(2)))
      [] pc = 69 -> Core(AckProposal(B, P(2)))
      [] pc = 70 -> Core(DeliverAck(B, PA(B, P(2))))

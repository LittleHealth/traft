      [] pc = 15 -> Core(AckProposal(B, P(1)))
      [] pc = 16 -> Core(DeliverAck(A, PA(B, P(1))))
      [] pc = 17 -> Core(ConfirmProposal(A))
      [] pc = 18 -> Core(CommitEntry(A, P(1).first))
      [] pc = 19 -> Core(Activate(A))
      [] pc = 20 -> Core(LearnConfirmation(B, P(1)))
      [] pc = 21 -> Core(AdoptTerm(C, 1))
      [] pc = 22 -> Core(CopyProposalEntry(C, A, P(1), P(1).first))
      [] pc = 23 -> Core(RetainProposal(C, P(1)))
      [] pc = 24 -> Core(LearnConfirmation(C, P(1)))
      [] pc = 25 -> Core(LearnCommit(B, CN(A, 1, P(1).first)))
      [] pc = 26 -> Core(LearnCommit(C, CN(A, 1, P(1).first)))
      [] pc = 27 -> ApplyClient(A, P(1).first)
      [] pc = 28 -> ApplyClient(B, P(1).first)
      [] pc = 29 -> ApplyClient(C, P(1).first)
      [] pc = 30 -> Invoke(PutX)
      [] pc = 31 -> Admit(A, PutX)
      [] pc = 32 -> Core(SendEntry(A, E(1, 2)))
      [] pc = 33 -> Core(ReceiveEntry(B, M(1, 2)))
      [] pc = 34 -> Core(AckEntry(A, M(1, 2)))
      [] pc = 35 -> Core(AckEntry(B, M(1, 2)))

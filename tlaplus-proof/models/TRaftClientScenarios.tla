      [] pc = 72 -> CopyMissing(C, B, P(2), E(1, 2))
      [] pc = 73 -> CopyMissing(C, B, P(2), E(1, 3))
      [] pc = 74 -> CopyMissing(C, B, P(2), P(2).first)
      [] pc = 75 -> Core(RetainProposal(C, P(2)))
      [] pc = 76 -> Core(AckProposal(C, P(2)))
